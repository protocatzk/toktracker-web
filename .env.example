# ---------------------------------------------------------------------------
# TokTracker-Web (externes Frontend + BFF)
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

# Origin(s), unter denen die SPA läuft (kommagetrennt).
# Im Dev-Modus: http://localhost:5173
# In Produktion: https://app.example.com
APP_ORIGIN=http://localhost:5173

# Session-Cookie
# SESSION_SECRET mit `openssl rand -hex 32` erzeugen. In Produktion Pflicht!
SESSION_SECRET=
SESSION_TTL_SECONDS=86400
# COOKIE_SECURE=true wird bei HTTPS/Produktion automatisch gesetzt.
# COOKIE_SECURE=false

# TokTracker-API
# Der API-Key bleibt ausschließlich im BFF und wird nie an den Browser gegeben.
TOKTRACKER_API_BASE=https://positronium.dev/track/api
TOKTRACKER_API_KEY=
TOKTRACKER_TIMEOUT_MS=30000

# Lokale Benutzerverwaltung (BFF)
DATA_DIR=data
ADMIN_USERNAME=admin
# Wird nur beim allerersten Start verwendet, wenn data/users.json noch fehlt.
# Leer lassen: dann wird ein Einmal-Passwort generiert und im Log ausgegeben.
ADMIN_PASSWORD=

# Login-Rate-Limit
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW=15 minutes
