{
  "name": "toktracker-web",
  "version": "0.1.0",
  "private": true,
  "description": "Externes Vue-3-Frontend für TT-INTELLIGENCE / TokTracker mit eigenem BFF",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run typecheck:web && npm run lint && npm run test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.12",
    "@lucide/vue": "^1.76.0",
    "@vueuse/core": "^15.0.0",
    "dotenv": "^18.0.10",
    "echarts": "^6.1.0",
    "fastify": "^5.12.8",
    "pinia": "^3.0.4",
    "pino": "^10.4.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.45",
    "vue-echarts": "^8.3.2",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.5.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.7.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.14"
  }
}
